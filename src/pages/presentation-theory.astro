---
import { presentationTheoryArticles } from "../data/presentationTheoryArticles";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Presentations"
  description="An exploratory note on restricted mathematical descriptions, with elementary examples and explicit limits."
  currentPath="/presentation-theory.html"
>
  <main class="shell article-shell">
    <article class="plain-page">
      <h1>Presentations</h1>
      <p>
        Can a choice of admissible descriptions suggest useful mathematics?
        The former Presentation theory collection has been withdrawn after
        critical review. What remains is one short exploratory note, with
        elementary examples and no claim of novelty or of a new general theory.
      </p>
      <p>
        The note was generated and revised with ChatGPT (GPT-5.5+).
        It has not been peer-reviewed.
      </p>
      <div class="article-list">
        {presentationTheoryArticles.map((article) => (
          <a class="article-list-item" href={article.href}>
            <time datetime={article.datetime}>{article.date}</time>
            <span>{article.title}</span>
            <p>{article.description}</p>
          </a>
        ))}
      </div>
    </article>
  </main>
</BaseLayout>
