---
import type { RenderedTexPaper } from "../lib/texPaper";
import { slugify } from "../lib/texPaper";
import GenerativeAiNotice from "./GenerativeAiNotice.astro";

interface Props {
  paper: RenderedTexPaper;
  sourceHref: string;
  dateTime: string;
  headingLevel: "h1" | "h2";
  showNotice?: boolean;
  eyebrow?: string;
}

const { paper, sourceHref, dateTime, headingLevel: Heading, eyebrow, showNotice = false } = Astro.props;
const paperId = slugify(paper.title);
---

<section class="tex-paper">
  <header class="plain-header paper-header">
    {eyebrow && <p class="paper-eyebrow">{eyebrow}</p>}
    <div class="article-meta">
      <time datetime={dateTime}>{paper.date}</time>
    </div>
    <Heading class="paper-document-title">{paper.title}</Heading>
    <p class="paper-author">{paper.author}</p>
    <div class="paper-actions" aria-label={`${paper.title} downloads`}>
      <a href={sourceHref} download>Download TeX source</a>
    </div>
  </header>

  {showNotice && <GenerativeAiNotice />}

  <section class="paper-abstract" aria-labelledby={`${paperId}-abstract`}>
    <h2 id={`${paperId}-abstract`}>Abstract</h2>
    <div set:html={paper.abstractHtml} />
  </section>

  <nav class="paper-toc" aria-label={`${paper.title} contents`}>
    <h2>Contents</h2>
    <ol>
      {
        paper.tocEntries.map((entry) => (
          <li class={entry.level === "subsection" ? "paper-toc-subsection" : undefined}>
            <a href={`#${entry.id}`}>
              <span>{entry.number}</span>
              <span set:html={entry.titleHtml} />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="paper-body" set:html={paper.bodyHtml} />

  {paper.bibliographyHtml !== "<ol></ol>" && <section class="paper-references" aria-label={`${paper.title} references`}>
    <h2>References</h2>
    <div set:html={paper.bibliographyHtml} />
  </section>}
</section>
