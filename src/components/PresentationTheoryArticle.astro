---
import { readFileSync } from "node:fs";
import type { PresentationTheoryArticle } from "../data/presentationTheoryArticles";
import { extractTexMacros, renderTexPaper } from "../lib/texPaper";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionBackLink from "./SectionBackLink.astro";
import TexPaperDocument from "./TexPaperDocument.astro";

interface Props { article: PresentationTheoryArticle }
const { article } = Astro.props;
const documents = article.assets.map((asset, index) => {
  const source = readFileSync(`public${asset.href}`, "utf8");
  return {
    asset,
    paper: renderTexPaper(source, { idPrefix: `${article.slug}-${index + 1}` }),
    macros: extractTexMacros(source),
  };
});
const macros = Object.assign({}, ...documents.map((document) => document.macros));
const collection = documents.length > 1;
---

<BaseLayout title={article.title} description={article.description} currentPath={article.href} bodyClass="paper-surface">
  <script is:inline define:vars={{ macros }}>
    window.MathJax = {
      tex: {
        inlineMath: [["\\(", "\\)"], ["$", "$"]],
        displayMath: [["\\[", "\\]"]],
        macros,
      },
    };
  </script>
  <script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
  <main class="shell article-shell">
    <article class="plain-page ai-article paper-page">
      <SectionBackLink href="/presentation-theory.html" label="Back to Presentations" />
      {collection && <header class="plain-header paper-header"><h1>{article.title}</h1></header>}
      {documents.map(({ paper, asset }, index) => (
        <TexPaperDocument
          paper={paper}
          sourceHref={asset.href}
          dateTime={article.datetime}
          headingLevel={collection ? "h2" : "h1"}
          showNotice={index === 0}
          eyebrow={collection ? (asset.href.includes("proof-audit") ? "Supplementary proof audit" : `Document ${index + 1}`) : undefined}
        />
      ))}
    </article>
  </main>
</BaseLayout>
